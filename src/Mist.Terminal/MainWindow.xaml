<Window x:Class="Mist.Terminal.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="Terminal" Icon="Assets/terminal.ico" Width="1280" Height="820" MinWidth="760" MinHeight="480"
 WindowStyle="None" ResizeMode="CanResize" Background="#292B30" WindowStartupLocation="CenterScreen">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" /></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <Style x:Key="TitleButton" TargetType="Button">
   <Setter Property="Foreground" Value="#BFC5CD"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,0"/><Setter Property="FontSize" Value="18"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bg" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#3B3F45"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bg" Property="Background" Value="#3B3F45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Border BorderBrush="#40434A" BorderThickness="1">
  <Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="6"/></Grid.RowDefinitions>
   <Grid Background="#25272B"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" Margin="17,0,25,0" VerticalAlignment="Center"><Image Source="Assets/terminal.png" Width="24" Height="24" Margin="0,0,8,0"/><TextBlock Text="Terminal" Foreground="#E1E3E8" FontSize="19.5" FontWeight="Medium" VerticalAlignment="Center"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal">
     <Button Style="{StaticResource TitleButton}" Content="连接 ⌄" Tag="connections" Click="ToolbarClick"/>
     <Button Style="{StaticResource TitleButton}" Content="搜索" Tag="search" Click="ToolbarClick"/>
     <Button Style="{StaticResource TitleButton}" Content="SFTP" Tag="files" Click="ToolbarClick"/>
     <Button Style="{StaticResource TitleButton}" Content="设置" Tag="settings" Click="ToolbarClick"/>
     <Button Style="{StaticResource TitleButton}" Content="帮助" Tag="help" Click="ToolbarClick"/>
    </StackPanel>
    <StackPanel Grid.Column="3" Orientation="Horizontal">
     <Button Style="{StaticResource TitleButton}" Width="46" Content="─" ToolTip="最小化" AutomationProperties.Name="最小化" Click="MinimizeClick"/>
     <Button x:Name="MaximizeButton" Style="{StaticResource TitleButton}" Width="46" Content="□" ToolTip="最大化 / 还原" AutomationProperties.Name="最大化或还原" Click="MaximizeClick"/>
     <Button Style="{StaticResource TitleButton}" Width="46" Content="×" FontSize="28.5" ToolTip="关闭" AutomationProperties.Name="关闭窗口" Click="CloseClick"/>
    </StackPanel>
   </Grid>
   <wv:WebView2 Grid.Row="1" x:Name="Web" DefaultBackgroundColor="#292B30" />
   <Border Grid.Row="2" Background="#2D2F34" IsHitTestVisible="False" />
  </Grid>
 </Border>
</Window>
